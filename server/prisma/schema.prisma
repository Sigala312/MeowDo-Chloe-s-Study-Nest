// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 1. 使用者模型（支援 OAuth 與 Gamification 數值）
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String? // 第三方登入的大頭貼
  bio           String? // 新增
  location      String? // 新增
  avatarUrl     String?   @db.LongText // 新增 (若已有 image 欄位，可視需求對應)

  // 🎮 遊戲化機制 (Gamification)
  level  Int @default(1)
  exp    Int @default(0) // 當前經驗值
  tokens Int @default(0) // 升級或完成專注獲得的代幣數

  // 🍅 新增番茄代幣機制
  tomatoes           Int      @default(0)
  todayTomatoesCount Int      @default(0)
  lastTomatoDate     DateTime @default(now())

  // 帳號與 Session (NextAuth / Auth.js 標準規格)
  accounts Account[]
  sessions Session[]

  tasks        Task[]
  pomodoros    PomodoroLog[]
  wheelRewards WheelReward[]
  drawLogs     WheelDrawLog[]
  categories   Category[]
  tags         Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 2. 待辦事項模型
model Task {
  id              String    @id @default(cuid())
  title           String // 事項名稱
  isCompleted     Boolean   @default(false)
  hasEarnedReward Boolean   @default(false)
  expReward       Int       @default(20) // 完成該任務可獲得的經驗值 (預設 20 EXP)
  scheduledTime   String? // 顯示時間標籤 (如 "10:00-11:30")
  dueDate         DateTime?
  completedAt     DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tags Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 3. 待辦分類模型
model Category {
  id    String  @id @default(cuid())
  name  String // "📖 國考進度", "☕ 每日生活"
  icon  String?
  color String?
  order Int     @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, userId])
  @@index([userId])
}

// 7. 🏷️ 標籤模型
model Tag {
  id    String  @id @default(cuid())
  name  String
  color String? // 標籤顏色 (如 "#FF5733")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks Task[] // 多對多關聯 (Prisma 會自動處理隱式關聯表 _TaskToTag)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, userId])
  @@index([userId])
}

// 4. 🍅 番茄鐘紀錄模型
model PomodoroLog {
  id          String   @id @default(cuid())
  durationMin Int      @default(25) // 專注分鐘數 (預設 25 分鐘)
  expEarned   Int      @default(10) // 完成一次番茄鐘可獲得的經驗值
  completedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 5. 🎡 輪盤獎品項目
model WheelReward {
  id          String  @id @default(cuid())
  title       String // 獎品名稱 (如 "☕ 熱可可兌換券", "🐾 貓咪讚賞勳章")
  icon        String? // 獎品圖示或類別
  categoryTag String? // 獎品標籤 (如 "Relax", "Food", "Entertainment", "Personal")
  probability Float // 中獎機率 (0.0 ~ 1.0)
  isRare      Boolean @default(false)

  // 綁定使用者（若希望系統預設獎品全站通用，也可設為 Optional `userId String?`）
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  drawLogs WheelDrawLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// 6. 🎟️ 抽獎歷史紀錄
model WheelDrawLog {
  id         String    @id @default(cuid())
  drawnAt    DateTime  @default(now())
  isRedeemed Boolean   @default(false) // 新增：兌換券是否已使用/兌換
  redeemedAt DateTime? // 新增：兌換時間

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rewardId String
  reward   WheelReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rewardId])
}

// --- NextAuth.js 標準第三方登入模型 (Google / GitHub) ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String // "google", "github" 等
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
